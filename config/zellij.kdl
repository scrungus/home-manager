theme "catppuccin-frappe"
host_notification_protocol "bell"
default_layout "default"
show_startup_tips false
show_release_notes false
show_setup_screen false

keybinds {
    tab {
        bind "h" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "l" { GoToNextTab; SwitchToMode "Normal"; }
        bind "w" {
            Run "zellij" "terminal" {
                background true
            }
            SwitchToMode "Normal";
        }
    }
}

terminal {
    font_size 14
    line_height 1.1
    padding 8
    cursor_style "bar"
    cursor_blink false
    bell "audible"

    theme {
        foreground "#c6d0f5"
        background "#303446"
        cursor "#f2d5cf"
        black "#51576d"
        red "#e78284"
        green "#a6d189"
        yellow "#e5c890"
        blue "#8caaee"
        magenta "#f4b8e4"
        cyan "#81c8be"
        white "#b5bfe2"
        bright_black "#626880"
        bright_red "#e78284"
        bright_green "#a6d189"
        bright_yellow "#e5c890"
        bright_blue "#8caaee"
        bright_magenta "#f4b8e4"
        bright_cyan "#81c8be"
        bright_white "#a5adce"
    }
}

attention {
    enabled true
    tab_markers true
    notification_details false
    startup_card "never"
    desktop_notifications {
        needs_you false
        failed false
        done false
    }
}

themes {
    tokyo-night {
        fg "#c0caf5"
        bg "#1a1b26"
        black "#16161e"
        red "#f7768e"
        green "#9ece6a"
        yellow "#e0af68"
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#a9b1d6"
        orange "#ff9e64"
    }
}
