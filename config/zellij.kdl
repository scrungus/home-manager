theme "catppuccin-mocha"
host_notification_protocol "bell"
default_layout "default"
show_startup_tips false
show_release_notes false
show_setup_screen false

ui {
    pane_frames {
        hide_session_name true
    }
}

keybinds {
    tab {
        bind "h" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "l" { GoToNextTab; SwitchToMode "Normal"; }
        bind "w" {
            Run "zellij-new-window" {
                background true
            }
            SwitchToMode "Normal";
        }
    }
}

terminal {
    font_size 14
    line_height 1.1
    padding 8
    opacity 0.85
    opacity_mode "background"
    blur true
    cursor_style "bar"
    cursor_blink false
    bell "audible"

    theme {
        foreground "#cdd6f4"
        background "#1e1e2e"
        cursor "#f5e0dc"
        black "#45475a"
        red "#f38ba8"
        green "#a6e3a1"
        yellow "#f9e2af"
        blue "#89b4fa"
        magenta "#f5c2e7"
        cyan "#94e2d5"
        white "#bac2de"
        bright_black "#585b70"
        bright_red "#f38ba8"
        bright_green "#a6e3a1"
        bright_yellow "#f9e2af"
        bright_blue "#89b4fa"
        bright_magenta "#f5c2e7"
        bright_cyan "#94e2d5"
        bright_white "#a6adc8"
    }
}

attention {
    enabled true
    tab_markers true
    notification_details false
    startup_card "never"
    desktop_notifications {
        needs_you false
        failed false
        done false
    }
}

themes {
    tokyo-night {
        fg "#c0caf5"
        bg "#1a1b26"
        black "#16161e"
        red "#f7768e"
        green "#9ece6a"
        yellow "#e0af68"
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#a9b1d6"
        orange "#ff9e64"
    }
}
